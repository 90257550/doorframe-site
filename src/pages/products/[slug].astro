---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { products } from '../../data/products';
import { site } from '../../config/site';

export function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const idx = products.findIndex((p) => p.slug === product.slug);
const prev = products[(idx - 1 + products.length) % products.length];
const next = products[(idx + 1) % products.length];

const specRows = [
  ['材质', product.material],
  ['表面处理', product.finish],
  ['型材规格', product.profile],
  ['适用场景', product.application],
];

// JSON-LD 结构化数据，提升 SEO
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.desc,
  category: product.tag,
  brand: { '@type': 'Brand', name: site.name },
  material: product.material,
};
---
<Base title={`${product.name} · ${site.name}`} description={product.desc}>
  <Header />

  <main>
    <section class="detail-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">首页</a>
          <span>/</span>
          <a href="/products/">产品系列</a>
          <span>/</span>
          <span class="breadcrumb-current">{product.name}</span>
        </nav>
        <h1 class="detail-title">{product.name}</h1>
        <p class="detail-lead">{product.desc}</p>
      </div>
    </section>

    <section class="section" style="padding-top: 48px;">
      <div class="container detail-grid">
        <!-- 左：可视化 -->
        <div class="detail-visual" aria-hidden="true">
          <svg viewBox="0 0 320 320" class="detail-svg" fill="none">
            <rect x="30" y="30" width="260" height="260" rx="4" stroke="#3a3d42" stroke-width="2"/>
            <rect x="60" y="60" width="200" height="200" rx="3" stroke="#4a4d53" stroke-width="1.5"/>
            <path d="M60 160h200 M160 60v200" stroke="#3a3d42" stroke-width="1"/>
            <path d="M150 140v40" stroke="var(--accent)" stroke-width="4" stroke-linecap="round"/>
            <path d="M30 30 L60 60 M290 30 L260 60 M30 290 L60 260 M290 290 L260 260" stroke="#2c2e32" stroke-width="1"/>
          </svg>
          <p class="detail-caption">型材截面示意图</p>
        </div>

        <!-- 右：规格 + 特性 -->
        <div class="detail-info">
          <h2 class="detail-subtitle">规格参数</h2>
          <table class="spec-table">
            <tbody>
              {specRows.map(([k, v]) => (
                <tr><th>{k}</th><td>{v}</td></tr>
              ))}
            </tbody>
          </table>

          <h2 class="detail-subtitle" style="margin-top: 40px;">产品特点</h2>
          <ul class="feature-list">
            {product.features.map((f) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="check-icon">
                  <path d="M3 8.5l3.5 3.5L13 4" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <div class="detail-cta">
            <a class="btn btn--primary" href="/#contact">获取报价</a>
            <a class="btn btn--ghost" href="/products/">返回产品列表</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 上一个/下一个 -->
    <nav class="detail-nav" aria-label="产品导航">
      <div class="container detail-nav__inner">
        <a class="detail-nav__item" href={`/products/${prev.slug}/`}>
          <small>上一款</small>
          <strong>← {prev.name}</strong>
        </a>
        <a class="detail-nav__item detail-nav__item--right" href={`/products/${next.slug}/`}>
          <small>下一款</small>
          <strong>{next.name} →</strong>
        </a>
      </div>
    </nav>
  </main>

  <Footer />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
  .detail-hero {
    background: var(--dark);
    color: #fff;
    padding: 48px 0 44px;
  }
  .breadcrumb {
    font-size: 13px;
    color: var(--ink-faint);
    margin-bottom: 20px;
    display: flex;
    gap: 8px;
  }
  .breadcrumb a:hover { color: #fff; }
  .breadcrumb-current { color: #9aa0a6; }

  .detail-title {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 750;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .detail-lead {
    color: var(--ink-faint);
    font-size: 15.5px;
    max-width: 580px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .detail-visual {
    background: linear-gradient(145deg, #232528, #1a1b1d);
    border-radius: var(--radius);
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: sticky;
    top: 80px;
  }
  .detail-svg { width: 100%; max-width: 260px; height: auto; }
  .detail-caption {
    margin-top: 20px;
    font-size: 12px;
    color: var(--ink-faint);
    text-align: center;
  }

  .detail-subtitle {
    font-size: 18px;
    font-weight: 650;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .feature-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .check-icon { flex-shrink: 0; margin-top: 3px; }

  .detail-cta {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .detail-nav {
    border-top: 1px solid var(--line);
    background: var(--bg-raised);
    padding: 28px 0;
  }
  .detail-nav__inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .detail-nav__item { display: flex; flex-direction: column; gap: 4px; }
  .detail-nav__item--right { text-align: right; }
  .detail-nav__item small { font-size: 11.5px; color: var(--ink-faint); text-transform: uppercase; letter-spacing: .08em; }
  .detail-nav__item strong { font-size: 14.5px; font-weight: 600; color: var(--ink); }
  .detail-nav__item:hover strong { color: var(--accent); }

  @media (max-width: 820px) {
    .detail-grid { grid-template-columns: 1fr; gap: 32px; }
    .detail-visual { position: static; }
  }
</style>
