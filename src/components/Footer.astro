---
import { site } from '../config/site';
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="footer-brand">{site.name}</p>
      <p class="footer-slogan">{site.slogan}</p>
    </div>
    <div>
      <p class="footer-label">联系方式</p>
      <ul class="footer-list">
        <li><a href={`tel:${site.phone.replace(/-/g, '')}`}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.hours}</li>
      </ul>
    </div>
    <div>
      <p class="footer-label">地址</p>
      <p class="footer-address">{site.address}</p>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <span>© {new Date().getFullYear()} {site.name}. 保留所有权利。</span>
    <span class="footer-note">门框加工 · 型材 · 精密制造</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--ink-faint);
    padding: 56px 0 28px;
    font-size: 13.5px;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid #2c2e31;
  }
  .footer-brand { color: #fff; font-size: 17px; font-weight: 700; margin-bottom: 4px; }
  .footer-slogan { font-size: 12.5px; }
  .footer-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--ink-faint);
    margin-bottom: 10px;
  }
  .footer-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .footer-list a:hover { color: #fff; }
  .footer-address { line-height: 1.7; }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 22px;
    font-size: 12.5px;
    color: #6c7076;
  }
  .footer-note { letter-spacing: .06em; }

  @media (max-width: 760px) {
    .site-footer__grid { grid-template-columns: 1fr; gap: 26px; }
    .site-footer__bottom { flex-direction: column; gap: 6px; }
  }
</style>
